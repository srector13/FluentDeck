<Project Sdk="Microsoft.NET.Sdk">
  <!-- The real host: a tray app for Windows 11 (Arm64 native; x64 also builds).
       Publish a single self-contained exe:
         dotnet publish -c Release -r win-arm64 -p:PublishSingleFile=true -p:SelfContained=true -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <AssemblyName>FluentDeck.Host</AssemblyName>
    <RootNamespace>FluentDeck.Host</RootNamespace>
    <Version>0.1.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Pinned to 2.2.1: the 3.x line changed the Core Audio API surface. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <ProjectReference Include="..\FluentDeck.Core\FluentDeck.Core.csproj" />
  </ItemGroup>
</Project>
